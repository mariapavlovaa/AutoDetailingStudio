    
@model AutoDetailingStudio.ViewModels.Subscription.SubscriptionEditViewModel

@{
    ViewData["Title"] = "Edit Subscription";
}

<div class="container mt-5 mb-5">
    <h2 class="mb-4">Edit Subscription</h2>

    <form asp-controller="Subscription"
          asp-action="Edit"
          asp-route-id="@Model.Id"
          method="post">

        @Html.AntiForgeryToken()

        <input asp-for="Id" type="hidden" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description"
                      class="form-control"
                      rows="4"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Price" class="form-label"></label>
            <input asp-for="Price"
                   type="number"
                   step="0.01"
                   class="form-control" />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="DiscountPercent" class="form-label"></label>
            <input asp-for="DiscountPercent"
                   type="number"
                   step="0.01"
                   class="form-control" />
            <span asp-validation-for="DiscountPercent"
                  class="text-danger"></span>
        </div>

        <div class="form-check mb-4">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label">
                Active Subscription
            </label>
        </div>

        <button type="submit" class="btn btn-dark">
            Save Changes
        </button>

        <a asp-action="Index"
           class="btn btn-outline-secondary ms-2">
            Cancel
        </a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
