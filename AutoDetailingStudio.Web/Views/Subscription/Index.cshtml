
@model IEnumerable<AutoDetailingStudio.ViewModels.Subscription.SubscriptionAllViewModel>

@{
    ViewData["Title"] = "Our Subscriptions";
}

@if (User.IsInRole("Admin"))
{
    <div class="d-flex justify-content-end mb-4">
        <a asp-controller="Subscription"
           asp-action="Create"
           class="btn btn-dark">
            + Create Subscription
        </a>
    </div>
}

<section class="subscriptions-page">

    <div class="subscriptions-header">
        <span class="subscriptions-label">AUTO DETAILING STUDIO</span>

        <h1 class="subscriptions-title">Our Subscriptions</h1>

        <p class="subscriptions-subtitle">
            Choose the membership that suits your needs
            and enjoy exclusive detailing benefits.
        </p>

        <div class="subscriptions-divider"></div>
    </div>

    <div class="row g-4 justify-content-center">
        @foreach (var subscription in Model)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <article class="subscription-card h-100">

                    <div class="subscription-content">

                        <span class="plan-label">MEMBERSHIP PLAN</span>

                        @if (User.IsInRole("Admin") && !subscription.IsActive)
                        {
                            <span class="badge bg-secondary ms-2">
                                Inactive
                            </span>
                        }

                        <h2 class="subscription-name">
                            @subscription.Name
                        </h2>

                        <div class="subscription-divider"></div>

                        <p class="subscription-price">
                            @subscription.Price.ToString("F2") €
                        </p>

                        <p class="subscription-caption">
                            Discover the benefits of this plan.
                        </p>

                        @if (User.IsInRole("Admin"))
                        {
                            <div class="d-flex gap-2 mt-4 flex-wrap">

                                <a asp-controller="Subscription"
                                   asp-action="Edit"
                                   asp-route-id="@subscription.Id"
                                   class="btn btn-dark">
                                    Edit Subscription
                                </a>

                                @if (subscription.IsActive)
                                {
                                    <form asp-controller="Subscription"
                                          asp-action="Delete"
                                          asp-route-id="@subscription.Id"
                                          method="post"
                                          onsubmit="return confirm('Are you sure you want to delete this subscription?');">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-outline-danger">
                                            Delete Subscription
                                        </button>
                                    </form>
                                }

                            </div>
                        }

                        @if (subscription.IsActive)
                        {
                            <a asp-controller="Subscription"
                               asp-action="Details"
                               asp-route-id="@subscription.Id"
                               class="subscription-btn">
                                Explore Plan
                                <span aria-hidden="true">→</span>
                            </a>
                        }

                    </div>
                </article>
            </div>
        }
    </div>

</section>
