@using AutoDetailingStudio.Data.Models
@model IEnumerable<AutoDetailingStudio.Web.Models.Service.ServiceAllViewModel>

@{
    ViewData["Title"] = "Our Services";
}
@if (User.IsInRole("Admin"))
{
    <div class="d-flex justify-content-end mb-4">
        <a asp-controller="Service"
           asp-action="Create"
           class="btn btn-dark">
            + Create Service
        </a>
    </div>
}

<section class="services-page">

    <div class="services-header">
        <span class="services-eyebrow">AUTO DETAILING STUDIO</span>

        <h1 class="services-title">Our Services</h1>

        <p class="services-subtitle">
            Exceptional care, attention to detail,
            and a flawless finish for your vehicle.
        </p>

        <div class="services-divider"></div>
    </div>

    <div class="row g-4">
        @foreach (var service in Model)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <article class="service-card h-100">

                    <div class="service-image-wrapper">
                        <img src="@(service.ImageUrl ?? "/images/placeholder.jpg")"
                             alt="@service.Name"
                             class="service-image" />
                    </div>

                    <div class="service-content">
                        <h2 class="service-name">
                            @service.Name
                        </h2>

                        <p class="service-price">
                            @service.Price.ToString("F2") €
                        </p>
                        
                        
                        @if (User.IsInRole("Admin"))
                        {
                        <div class="d-flex gap-3 mt-4">

                            <a asp-controller="Service"
                               asp-action="Edit"
                               asp-route-id="@service.Id"
                               class="btn btn-dark">
                                Edit Service
                            </a>

                            <form asp-controller="Service"
                                  asp-action="Delete"
                                  asp-route-id="@service.Id"
                                  method="post"
                                  onsubmit="return confirm('Are you sure you want to delete this service?');">

                                <button type="submit" class="btn btn-outline-danger">
                                    Delete Service
                                </button>
                            </form>

                        </div>
                        }
                        
                        

                        <a asp-controller="Service"
                           asp-action="Details"
                           asp-route-id="@service.Id"
                           class="service-btn">
                            Explore Service
                            <span aria-hidden="true">→</span>
                            
                        </a>
                        
                    </div>

                </article>
            </div>
        }
    </div>

</section>