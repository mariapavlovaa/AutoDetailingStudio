@{
    ViewData["Title"] = "Privacy Policy";
}

<section class="privacy-page">
    <div class="privacy-header">
        <span class="privacy-eyebrow">AUTO DETAILING STUDIO</span>
        <h1>Privacy Policy</h1>
        <p>
            Your privacy matters to us. Learn how AutoDetailingStudio
            handles information provided through our website.
        </p>
        <div class="privacy-divider"></div>
    </div>

    <div class="privacy-content">
        <h2>1. Information We Collect</h2>
        <p>
            When you register or use our services, we may collect
            information such as your name, email address, phone number,
            vehicle details, and appointment information.
        </p>

        <h2>2. How We Use Your Information</h2>
        <p>
            We use the information you provide to manage your account,
            organize appointments, and deliver our detailing services.
        </p>

        <h2>3. Data Security</h2>
        <p>
            We take reasonable measures to protect personal information
            and restrict access to authorized users.
        </p>

        <h2>4. Your Information</h2>
        <p>
            You may contact the website administrator regarding
            questions about your personal information.
        </p>

        <h2>5. Contact</h2>
        <p>
            For questions regarding this privacy policy,
            please contact AutoDetailingStudio.
        </p>
    </div>
</section>